#!/bin/sh

# On Alpine virt kernel, modules live in the companion initramfs.
# Load them if available (silently skip if not present).
modprobe virtio_blk 2>/dev/null
modprobe ext4 2>/dev/null

mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

ifconfig lo up

echo "[init] mounting persistent /var..."
if mount -t ext4 /dev/vda /var 2>/dev/null || mount -t ext2 /dev/vda /var 2>/dev/null; then
    echo "[init] persistent /var mounted"
    mkdir -p /var/boos/requests /var/boos/results /var/log
    sync
else
    echo "[init] no persistent disk, using tmpfs"
    mkdir -p /var/boos/requests /var/boos/results /var/log
fi

echo "[init] network: e1000 only (no modules needed)"
ifconfig eth0 up 2>/dev/null && udhcpc -q -t 3 -n -i eth0 -s /usr/share/udhcpc/default.script 2>/dev/null || true
IP=$(ifconfig eth0 2>/dev/null | grep 'inet addr:' | cut -d: -f2 | cut -d' ' -f1)
if [ -n "$IP" ]; then
    echo "[init] network up: eth0=$IP"
else
    echo "[init] network: guest DHCP failed (host port forward still works)"
fi

echo "================================================"
echo " minimalLinuxCore booted"
echo " BoOS substrate v0"
echo "================================================"

echo "[init] creating system users..."
adduser -D -s /bin/sh boos-gateway 2>/dev/null || true
adduser -D -s /bin/sh boos-agent 2>/dev/null || true

if [ -f /etc/boos/agent.conf ]; then
    chown boos-gateway:boos-gateway /etc/boos/agent.conf 2>/dev/null || true
    chmod 400 /etc/boos/agent.conf 2>/dev/null || true
    echo "[init] agent.conf protected (owner: boos-gateway, mode: 400)"
fi

echo "[init] starting boos-supervisor..."
exec /bin/boos-supervisor
